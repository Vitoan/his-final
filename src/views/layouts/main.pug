doctype html
html(lang="es" class="light")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title HIS - Sistema Hospitalario
    script(src="https://cdn.tailwindcss.com")
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet")
    
    script.
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: { sans: ['Inter', 'sans-serif'] }
          }
        }
      }

  body(class="min-h-screen bg-slate-100 text-slate-900 dark:bg-slate-900 dark:text-slate-100 flex transition-colors duration-300")

    mixin navLink(href, icon, text)
      a(href=href class="group flex items-center p-3 rounded-xl border border-transparent hover:border-slate-200 dark:hover:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50 hover:text-slate-900 dark:hover:text-white transition-all font-medium")
        span(class="mr-3 text-lg group-hover:scale-110 transition-transform") #{icon}
        span #{text}

    if usuario
      aside(class="w-72 bg-white dark:bg-slate-800 border-r border-slate-300 dark:border-slate-700 hidden md:flex flex-col fixed h-full z-20 shadow-xl")
        
        a(href="/" class="p-8 flex items-center gap-3 hover:opacity-80 transition-opacity cursor-pointer")
          div(class="w-10 h-10 rounded-xl bg-blue-600 dark:bg-rose-600 flex items-center justify-center text-white font-bold shadow-lg") H
          span(class="text-xl font-bold tracking-tight text-slate-800 dark:text-white") HIS <span class="text-blue-600 dark:text-rose-500">App</span>

        nav(class="flex-1 px-4 space-y-1 overflow-y-auto mt-2")

          // =====================
          // ROL: ADMISIÓN
          // =====================
          if ['Admin', 'Admision'].includes(usuario.rol)
            div(class="px-3 pt-3 pb-1")
              p(class="text-xs font-bold text-slate-400 uppercase tracking-widest px-2 mb-1") Admisión y Camas
            +navLink('/admision', '📋', 'Gestión de Pacientes')
            +navLink('/admision/listado', '📝', 'Listado de Admisiones')
            +navLink('/admision/nueva', '➕', 'Nueva Admisión')
            +navLink('/habitaciones', '🛏️', 'Mapa de Camas')
            +navLink('/mesa-entrada', '🛎️', 'Mesa de Entrada')

          // =====================
          // ROL: MÉDICO
          // =====================
          if ['Admin', 'Medico'].includes(usuario.rol)
            div(class="px-3 pt-4 pb-1")
              p(class="text-xs font-bold text-slate-400 uppercase tracking-widest px-2 mb-1") Médico
            +navLink('/clinica/dashboard', '🩺', 'Tablero Clínico')
            +navLink('/habitaciones', '🛏️', 'Mapa de Camas')
            // +navLink('/medico/evolucionar', '📝', 'Evoluciones')  // Descomentar si tenés listado

          // =====================
          // ROL: ENFERMERÍA
          // =====================
          if ['Admin', 'Enfermeria'].includes(usuario.rol)
            div(class="px-3 pt-4 pb-1")
              p(class="text-xs font-bold text-slate-400 uppercase tracking-widest px-2 mb-1") Enfermería
            +navLink('/clinica/dashboard', '🩺', 'Tablero Clínico')
            +navLink('/habitaciones', '🛏️', 'Mapa de Camas')
            // +navLink('/enfermeria/evaluar', '🩹', 'Signos Vitales')

          // =====================
          // ROL: ADMIN
          // =====================
          if usuario.rol === 'Admin'
            div(class="px-3 pt-4 pb-1 border-t border-slate-200 dark:border-slate-700 mt-3")
              p(class="text-xs font-bold text-slate-400 uppercase tracking-widest px-2 mb-1") Administración
            +navLink('/admin/usuarios', '👥', 'Gestión de Personal')
            +navLink('/admin/alas', '🏥', 'Gestión de Alas')
            +navLink('/admin/habitaciones', '🛏️', 'Gestión de Habitaciones')
            +navLink('/admin/camas', '🛌', 'Gestión de Camas')
            +navLink('/admin/auditoria', '📜', 'Auditoría del Sistema')
            +navLink('/admin/reportes', '📊', 'Reportes')

          // =====================
          // ROL: PACIENTE
          // =====================
          if usuario.rol === 'Paciente'
            +navLink('/portal/inicio', '🏥', 'Mi Portal de Salud')

        // Footer
        div(class="p-6 border-t border-slate-200 dark:border-slate-700 mt-auto")
          div(class="flex items-center gap-3 mb-4")
            div(class="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center font-bold text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-600") #{usuario.nombre.charAt(0)}
            div
              p(class="text-sm font-bold truncate w-32 dark:text-white") #{usuario.nombre}
              p(class="text-xs text-slate-500 dark:text-slate-400") #{usuario.rol}
          
          a(href="/auth/logout" class="block w-full text-center text-xs text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 py-2.5 rounded-lg transition-colors font-bold") Cerrar Sesión

    main(class=`flex-1 ${usuario ? 'md:ml-72' : ''} p-6 md:p-12 lg:p-16 w-full`)
      block content
extends ../layouts/main

block content
  div(class="max-w-6xl mx-auto mt-10 mb-20 px-4")
    
    //- Bienvenida
    div(class="mb-10 text-center md:text-left")
      h1(class="text-4xl font-black text-slate-900") Hola, #{paciente.nombre} 👋
      p(class="text-slate-500 mt-2 text-lg") Bienvenida/o a tu portal personal de salud.

    div(class="grid grid-cols-1 lg:grid-cols-3 gap-8")
      
      //- COLUMNA IZQUIERDA
      div(class="lg:col-span-2 space-y-8")
        
        //- PRÓXIMOS TURNOS
        section(class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm")
          h3(class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2") 📅 Mis Próximos Turnos
          if paciente.Turnos && paciente.Turnos.length > 0
            div(class="space-y-4")
              each turno in paciente.Turnos
                div(class="flex items-center justify-between p-4 bg-sky-50 rounded-2xl border border-sky-100")
                  div
                    p(class="font-bold text-sky-900") #{turno.especialidad}
                    p(class="text-sm text-sky-700") Dr/a. #{turno.Medico.apellido}
                  div(class="text-right")
                    p(class="font-black text-slate-800") #{new Date(turno.fecha + 'T00:00:00').toLocaleDateString()}
                    p(class="text-xs font-bold text-sky-600 uppercase") #{turno.hora.substring(0,5)} hs
          else
            p(class="text-slate-400 italic") No tienes turnos programados.

        section(class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm")
          h3(class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2") 🔬 Mis Estudios y Resultados
          
          if paciente.Estudios && paciente.Estudios.length > 0
            div(class="space-y-4")
              each est in paciente.Estudios.slice(0, 4)
                div(class="p-4 border border-slate-200 rounded-2xl")
                  div(class="flex justify-between items-start")
                    div
                      span(class="text-xs font-bold uppercase tracking-widest text-fuchsia-600") #{est.tipo_estudio}
                      p(class="font-bold text-slate-900 mt-1") #{est.descripcion}
                    
                    if est.estado === 'Realizado'
                      span(class="px-3 py-1 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full") ✅ Listo
                    else
                      span(class="px-3 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full") ⏳ Pendiente

                  if est.estado === 'Realizado' && est.resultado
                    details(class="mt-3")
                      summary(class="cursor-pointer text-sm font-bold text-blue-600 hover:underline")
                        | Ver resultado del estudio
                      div(class="mt-3 p-4 bg-slate-50 rounded-xl text-sm text-slate-700 whitespace-pre-line border border-slate-200")
                        | #{est.resultado}
          else
            p(class="text-slate-400 italic") No tienes estudios registrados.

        section(class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm")
          h3(class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2") 💊 Mis Indicaciones y Medicamentos
          
          if indicacionesActivas && indicacionesActivas.length > 0
            div(class="space-y-4")
              each ind in indicacionesActivas
                div(class="p-4 border border-emerald-200 bg-emerald-50 rounded-2xl")
                  div(class="flex justify-between items-start")
                    div
                      p(class="font-bold text-emerald-900 text-lg") #{ind.descripcion}
                      p(class="text-sm text-emerald-700 mt-1") 
                        | Dosis: #{ind.dosis || '-'} • Frecuencia: #{ind.frecuencia || '-'}
                    span(class="px-3 py-1 bg-emerald-200 text-emerald-800 text-xs font-bold rounded-full self-start") Activa
                  
                  if ind.Medico
                    p(class="text-xs text-emerald-600 mt-2") 
                      | Indicado por: Dr/a. #{ind.Medico.nombre} #{ind.Medico.apellido}
          else
            p(class="text-slate-400 italic") No tienes indicaciones de medicamentos activas en este momento.

        //- BOTÓN VER HISTORIA CLÍNICA
        div(class="mt-2")
          a(href=`/clinica/historial/${paciente.id}` 
            class="block w-full text-center bg-white border-2 border-slate-300 hover:bg-slate-50 text-slate-700 font-bold py-3.5 rounded-2xl transition-colors")
            | 📜 Ver mi Historia Clínica completa

      //- COLUMNA DERECHA
      div(class="space-y-8")
        
        //- FICHA PERSONAL
        div(class="bg-indigo-600 text-white rounded-[2rem] p-8 shadow-lg shadow-indigo-200")
          h3(class="font-bold text-lg mb-4 opacity-80") Mi Ficha
          div(class="space-y-2")
            p(class="text-2xl font-black") #{paciente.apellido}, #{paciente.nombre}
            p(class="text-sm") DNI: #{paciente.dni}
            p(class="text-sm") Obra Social: #{paciente.obra_social || 'Particular'}
        
        //- ESTADO DE INTERNACIÓN + SIGNOS VITALES
        if paciente.Internacions && paciente.Internacions.some(i => i.estado === 'Activa')
          - const inter = paciente.Internacions.find(i => i.estado === 'Activa')
          div(class="bg-rose-50 border-2 border-rose-200 rounded-[2rem] p-8")
            h3(class="text-rose-700 font-bold mb-2") 🏥 Actualmente Internado
            p(class="text-sm text-slate-600") Te encuentras en:
            p(class="text-lg font-black text-slate-900") Habitación #{inter.Cama.Habitacion.numero} - Cama #{inter.Cama.numero_cama}
            p(class="text-xs text-rose-500 mt-2 font-bold uppercase") #{inter.Cama.Habitacion.tipo}

            if ultimosSignos
              div(class="mt-6 pt-6 border-t border-rose-200")
                h4(class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3") 📊 Últimos Signos Vitales
                div(class="grid grid-cols-3 gap-2 text-center bg-white rounded-xl p-3 border border-rose-100")
                  div
                    span(class="block text-[9px] text-slate-400 uppercase") Presión
                    span(class="font-mono font-bold text-slate-800 text-xs") #{ultimosSignos.presion_arterial || '-'}
                  div(class="border-l border-slate-100")
                    span(class="block text-[9px] text-slate-400 uppercase") Pulso
                    span(class="font-mono font-bold text-slate-800 text-xs") #{ultimosSignos.frecuencia_cardiaca || '-'}
                  div(class="border-l border-slate-100")
                    span(class="block text-[9px] text-slate-400 uppercase") Temp
                    span(class="font-mono font-bold text-slate-800 text-xs") #{ultimosSignos.temperatura || '-'}°
                if ultimosSignos.observaciones
                  p(class="text-xs text-slate-500 italic mt-3 line-clamp-2") "#{ultimosSignos.observaciones}"
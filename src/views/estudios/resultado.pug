extends ../layouts/main

block content
  div(class="max-w-3xl mx-auto mt-8")
    div(class="mb-6 flex justify-between items-center")
      div
        h2(class="text-sm font-bold text-indigo-500 uppercase tracking-widest") Estudios
        h1(class="text-3xl font-black") Resultado del Estudio
      a(href="/estudios" class="text-slate-500 hover:text-slate-700 font-bold") ← Volver al Listado

    div(class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm")
      
      // Información básica del estudio
      div(class="mb-8")
        p(class="text-sm text-slate-500") Paciente
        p(class="text-xl font-bold") #{estudio.Paciente.apellido}, #{estudio.Paciente.nombre}
        
        p(class="text-sm text-slate-500 mt-4") Tipo de Estudio
        p(class="text-lg font-bold") #{estudio.tipo_estudio}

        p(class="text-sm text-slate-500 mt-4") Indicación Médica
        p(class="text-slate-700") #{estudio.descripcion}

      // === LÓGICA CORRECTA: Mostrar resultado o formulario ===
      if yaTieneResultado
        // CASO 1: El estudio ya tiene resultado → Mostrar en solo lectura
        div(class="border-t border-slate-200 pt-6")
          h3(class="text-lg font-bold text-emerald-700 mb-3") ✅ Resultado del Estudio
          div(class="bg-emerald-50 border border-emerald-200 rounded-2xl p-6")
            p(class="text-slate-800 whitespace-pre-line") #{estudio.resultado}
          
          if estudio.fecha_realizacion
            p(class="text-xs text-slate-500 mt-4") 
              | Realizado el: #{new Date(estudio.fecha_realizacion).toLocaleDateString()}

      else
        // CASO 2: El estudio NO tiene resultado → Mostrar formulario
        form(action=`/estudios/${estudio.id}/resultado` method="POST" class="space-y-6")
          div
            label(class="block text-sm font-bold text-slate-700 mb-2") Resultado del Estudio
            textarea(name="resultado" rows="8" required placeholder="Escriba aquí el resultado del estudio..." class="w-full border border-slate-300 rounded-2xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 outline-none resize-y")

          button(type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-2xl transition")
            | Guardar Resultado
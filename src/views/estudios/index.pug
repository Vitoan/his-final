extends ../layouts/main

block content
  div(class="max-w-7xl mx-auto")
    
    // Header
    div(class="flex justify-between items-center mb-8")
      div
        h2(class="text-xs font-bold text-indigo-500 uppercase tracking-widest mb-1") Diagnóstico por Imágenes y Laboratorio
        h1(class="text-3xl font-black") Gestión de Estudios
      a(href="/estudios/nuevo" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl font-bold flex items-center gap-2 transition-colors")
        span +
        | Solicitar Nuevo Estudio

    // Tabla
    div(class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm")
      table(class="w-full text-left border-collapse")
        thead(class="bg-slate-50 border-b border-slate-200 text-slate-500 text-xs uppercase tracking-wider")
          tr
            th(class="p-5 font-bold") Paciente
            th(class="p-5 font-bold") Tipo de Estudio
            th(class="p-5 font-bold") Descripción
            th(class="p-5 font-bold text-center") Estado
            th(class="p-5 font-bold") Fecha Solicitud
            th(class="p-5 font-bold text-center") Acciones

        tbody(class="divide-y divide-slate-100")
          if estudios && estudios.length > 0
            each estudio in estudios
              tr(class="hover:bg-slate-50 transition-colors")
                
                // Paciente
                td(class="p-5")
                  if estudio.Paciente
                    p(class="font-bold text-slate-900") #{estudio.Paciente.apellido}, #{estudio.Paciente.nombre}
                    p(class="text-xs text-slate-500") DNI: #{estudio.Paciente.dni || 'NN'}
                  else
                    span(class="text-slate-400 italic") Paciente eliminado

                // Tipo
                td(class="p-5 font-medium") #{estudio.tipo_estudio}

                // Descripción
                td(class="p-5 text-sm text-slate-600 max-w-xs truncate")
                  | #{estudio.descripcion || '-'}

                // Estado
                td(class="p-5 text-center")
                  if estudio.estado === 'Pendiente'
                    span(class="px-3 py-1 bg-amber-100 text-amber-700 rounded-full text-xs font-bold") ⏳ Pendiente
                  else if estudio.estado === 'Realizado'
                    span(class="px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full text-xs font-bold") ✅ Realizado
                  else
                    span(class="px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-xs font-bold") #{estudio.estado}

                // Fecha
                td(class="p-5 text-sm text-slate-600")
                  | #{new Date(estudio.fecha_solicitud).toLocaleDateString()}

                // Acciones
                td(class="p-5 text-center")
                  if estudio.estado === 'Pendiente'
                    a(href=`/estudios/${estudio.id}/resultado` 
                      class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-1.5 rounded-lg text-xs font-bold transition-colors")
                      | Cargar Resultado
                  else
                    a(href=`/estudios/${estudio.id}/resultado` 
                      class="text-indigo-600 hover:underline text-xs font-bold")
                      | Ver Resultado
          else
            tr
              td(colspan="6" class="p-16 text-center text-slate-500")
                div
                  div(class="text-5xl mb-4") 📋
                  p(class="text-lg font-bold") No hay estudios registrados
extends ../layouts/main

block content
  div(class="max-w-7xl mx-auto mt-6 mb-10")
    
    // Header
    div(class="flex justify-between items-center mb-8")
      div
        h1(class="text-4xl font-black text-slate-900") Mesa de Entrada
        p(class="text-slate-500 mt-1") Recepción y gestión de pacientes sin turno

      // Botón principal: Ingreso Rápido NN
      form(action="/mesa-entrada/ingreso-nn" method="POST" 
           onsubmit="return confirm('¿Realizar ingreso rápido de paciente NN?');")
        button(type="submit" 
               class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-2xl flex items-center gap-2 shadow-md transition-all active:scale-95")
          span(class="text-xl") 🚨
          | Ingreso Rápido NN

    // Buscador rápido
    div(class="bg-white border border-slate-200 rounded-3xl p-6 mb-8 shadow-sm")
      form(action="/mesa-entrada/nuevo" method="GET" class="flex gap-4 items-end")
        div(class="flex-1")
          label(class="block text-sm font-bold text-slate-600 mb-2") Buscar paciente por DNI
          input(type="text" name="dni" placeholder="Ingrese DNI..." 
                class="w-full px-4 py-3 border border-slate-300 rounded-2xl text-lg focus:ring-2 focus:ring-blue-500 outline-none")
        button(type="submit" 
               class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-2xl font-bold h-[52px]")
          | Buscar y Registrar Visita

    // Mensaje de orientación
    div(class="mb-6 flex items-center gap-3 text-sm text-slate-500")
      span(class="text-xl") ℹ️
      p 
        | ¿Necesita registrar un paciente con todos sus datos? 
        a(href="/admision/nuevo" class="text-blue-600 hover:underline font-bold") Ir a Admisión

    // Sala de Espera
    div(class="mb-4 flex items-center justify-between")
      h2(class="text-2xl font-bold text-slate-800") Pacientes en Sala de Espera
      if espera && espera.length > 0
        span(class="px-4 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-bold")
          | #{espera.length} en espera

    if espera && espera.length > 0
      div(class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm")
        table(class="w-full text-left border-collapse")
          thead(class="bg-slate-50 border-b border-slate-200 text-slate-500 text-xs uppercase tracking-wider")
            tr
              th(class="p-4 font-bold") Llegada
              th(class="p-4 font-bold") Paciente
              th(class="p-4 font-bold") Motivo
              th(class="p-4 font-bold text-center") Prioridad
              th(class="p-4 font-bold text-center") Estado
              th(class="p-4 font-bold text-center") Acciones

          tbody(class="divide-y divide-slate-100")
            each visita in espera
              tr(class="hover:bg-slate-50 transition-colors")
                
                td(class="p-4")
                  div(class="font-bold text-slate-800") 
                    | #{new Date(visita.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}
                  div(class="text-xs text-slate-400") 
                    | #{new Date(visita.createdAt).toLocaleDateString()}

                td(class="p-4")
                  p(class="font-bold text-slate-900") #{visita.Paciente.apellido}, #{visita.Paciente.nombre}
                  if visita.Paciente.es_nn
                    span(class="inline-block mt-1 bg-red-100 text-red-700 text-[10px] font-bold px-2 py-0.5 rounded-md") SIN IDENTIFICAR

                td(class="p-4 text-sm text-slate-600") #{visita.motivo}

                td(class="p-4 text-center")
                  if visita.prioridad === 'Alta/Emergencia'
                    span(class="bg-red-100 text-red-700 px-3 py-1 rounded-lg text-xs font-bold") 🔴 Alta
                  else if visita.prioridad === 'Media'
                    span(class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-lg text-xs font-bold") 🟡 Media
                  else
                    span(class="bg-green-100 text-green-700 px-3 py-1 rounded-lg text-xs font-bold") 🟢 Baja

                td(class="p-4 text-center")
                  if visita.estado === 'En Atención'
                    span(class="bg-orange-100 text-orange-700 px-3 py-1 rounded-lg text-xs font-bold") En Atención
                  else
                    span(class="bg-blue-100 text-blue-700 px-3 py-1 rounded-lg text-xs font-bold") Esperando

                td(class="p-4")
                  div(class="flex justify-center gap-2")
                    form(action=`/mesa-entrada/atender/${visita.id}` method="POST")
                      button(type="submit" class="bg-slate-800 hover:bg-black text-white px-3 py-1.5 rounded-lg text-xs font-bold transition-colors") Llamar
                  
                    form(action=`/mesa-entrada/internar/${visita.id}` method="POST")
                      button(type="submit" class="bg-violet-100 text-violet-700 hover:bg-violet-200 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors") Internar
                  
                    form(action=`/mesa-entrada/finalizar/${visita.id}` method="POST")
                      button(type="submit" class="bg-green-100 text-green-700 hover:bg-green-200 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors") Alta
    else
      // Estado vacío
      div(class="bg-white border border-slate-200 rounded-3xl p-16 text-center")
        div(class="text-6xl mb-6 opacity-30") 🛎️
        h3(class="text-2xl font-bold text-slate-700 mb-2") No hay pacientes esperando
        p(class="text-slate-500 max-w-md mx-auto") 
          | Los pacientes que lleguen por guardia o sin turno aparecerán en esta lista.

extends layouts/main

block content
  // --- HEADER DE BIENVENIDA ---
  div(class="max-w-6xl mx-auto mb-12 text-center pt-10")
    div(class="inline-flex items-center justify-center w-16 h-16 rounded-3xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-3xl font-bold mb-6 shadow-xl shadow-slate-500/20")
      | H
    h1(class="text-4xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4")
      | Bienvenido a <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-teal-500">HIS Pro</span>
    p(class="text-lg text-slate-500 dark:text-slate-400 max-w-2xl mx-auto")
      | Sistema Integral de Gestión Hospitalaria. Selecciona un módulo para comenzar a trabajar.

  // --- GRID DE MÓDULOS POR ROL ---
  div(class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 px-4")

    // ============================================
    // MÓDULOS PARA ADMISIÓN
    // ============================================
    if ['Admin', 'Admision'].includes(usuario.rol)
      // Mesa de Entrada
      a(href="/mesa-entrada" class="group relative bg-white dark:bg-slate-800 rounded-[2.5rem] p-8 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 overflow-hidden")
        div(class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-indigo-50 dark:bg-indigo-900/20 rounded-full blur-3xl group-hover:bg-indigo-100 dark:group-hover:bg-indigo-900/40 transition-colors")
        div(class="relative z-10")
          div(class="w-14 h-14 rounded-2xl bg-indigo-100 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-300 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform")
            | 🛎️
          h3(class="text-2xl font-bold text-slate-900 dark:text-white mb-2") Mesa de Entrada
          p(class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed")
            | Recepción de pacientes, triaje, guardia y registro de visitas.

      // Admisión
      a(href="/admision" class="group relative bg-white dark:bg-slate-800 rounded-[2.5rem] p-8 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 overflow-hidden")
        div(class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-blue-50 dark:bg-blue-900/20 rounded-full blur-3xl group-hover:bg-blue-100 dark:group-hover:bg-blue-900/40 transition-colors")
        div(class="relative z-10")
          div(class="w-14 h-14 rounded-2xl bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-300 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform")
            | 📋
          h3(class="text-2xl font-bold text-slate-900 dark:text-white mb-2") Admisión
          p(class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed")
            | Registro de pacientes y gestión de admisiones.

      // Mapa de Camas
      a(href="/habitaciones" class="group relative bg-white dark:bg-slate-800 rounded-[2.5rem] p-8 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 overflow-hidden")
        div(class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-rose-50 dark:bg-rose-900/20 rounded-full blur-3xl group-hover:bg-rose-100 dark:group-hover:bg-rose-900/40 transition-colors")
        div(class="relative z-10")
          div(class="w-14 h-14 rounded-2xl bg-rose-100 text-rose-600 dark:bg-rose-900/30 dark:text-rose-300 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform")
            | 🛏️
          h3(class="text-2xl font-bold text-slate-900 dark:text-white mb-2") Gestión de Camas
          p(class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed")
            | Visualización en tiempo real de ocupación y asignación de camas.

    // ============================================
    // MÓDULO CLÍNICO (Médico + Enfermería)
    // ============================================
    if ['Admin', 'Medico', 'Enfermeria'].includes(usuario.rol)
      
      // Tarjeta 1: Área Clínica (ya existente)
      a(href="/clinica/dashboard" class="group relative bg-white dark:bg-slate-800 rounded-[2.5rem] p-8 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 overflow-hidden")
        div(class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-teal-50 dark:bg-teal-900/20 rounded-full blur-3xl group-hover:bg-teal-100 dark:group-hover:bg-teal-900/40 transition-colors")
        div(class="relative z-10")
          div(class="w-14 h-14 rounded-2xl bg-teal-100 text-teal-600 dark:bg-teal-900/30 dark:text-teal-300 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform")
            | 🩺
          h3(class="text-2xl font-bold text-slate-900 dark:text-white mb-2") Área Clínica
          p(class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed")
            | Evoluciones, signos vitales e historia clínica.

      // === NUEVA TARJETA: ESTUDIOS MÉDICOS ===
      if ['Admin', 'Medico'].includes(usuario.rol)
        a(href="/estudios" class="group relative bg-white dark:bg-slate-800 rounded-[2.5rem] p-8 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 overflow-hidden")
          div(class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-violet-50 dark:bg-violet-900/20 rounded-full blur-3xl group-hover:bg-violet-100 dark:group-hover:bg-violet-900/40 transition-colors")
          div(class="relative z-10")
            div(class="w-14 h-14 rounded-2xl bg-violet-100 text-violet-600 dark:bg-violet-900/30 dark:text-violet-300 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform")
              | 📋
            h3(class="text-2xl font-bold text-slate-900 dark:text-white mb-2") Estudios Médicos
            p(class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed")
              | Solicitar radiografías, laboratorios y ver resultados.

    // ============================================
    // MÓDULOS SOLO PARA ADMIN
    // ============================================
    if usuario.rol === 'Admin'
      // Gestión de Personal
      a(href="/admin/usuarios" class="group relative bg-white dark:bg-slate-800 rounded-[2.5rem] p-8 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 overflow-hidden")
        div(class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-purple-50 dark:bg-purple-900/20 rounded-full blur-3xl group-hover:bg-purple-100 dark:group-hover:bg-purple-900/40 transition-colors")
        div(class="relative z-10")
          div(class="w-14 h-14 rounded-2xl bg-purple-100 text-purple-600 dark:bg-purple-900/30 dark:text-purple-300 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform")
            | 👥
          h3(class="text-2xl font-bold text-slate-900 dark:text-white mb-2") Gestión de Personal
          p(class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed")
            | Administración de usuarios y roles del sistema.

      // Auditoría
      a(href="/admin/auditoria" class="group relative bg-white dark:bg-slate-800 rounded-[2.5rem] p-8 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 overflow-hidden")
        div(class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-amber-50 dark:bg-amber-900/20 rounded-full blur-3xl group-hover:bg-amber-100 dark:group-hover:bg-amber-900/40 transition-colors")
        div(class="relative z-10")
          div(class="w-14 h-14 rounded-2xl bg-amber-100 text-amber-600 dark:bg-amber-900/30 dark:text-amber-300 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform")
            | 📜
          h3(class="text-2xl font-bold text-slate-900 dark:text-white mb-2") Auditoría del Sistema
          p(class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed")
            | Registro histórico de acciones y cambios en el sistema.

      // Reportes
      a(href="/admin/reportes" class="group relative bg-white dark:bg-slate-800 rounded-[2.5rem] p-8 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 overflow-hidden")
        div(class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-emerald-50 dark:bg-emerald-900/20 rounded-full blur-3xl group-hover:bg-emerald-100 dark:group-hover:bg-emerald-900/40 transition-colors")
        div(class="relative z-10")
          div(class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-300 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform")
            | 📊
          h3(class="text-2xl font-bold text-slate-900 dark:text-white mb-2") Reportes
          p(class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed")
            | Estadísticas e indicadores del sistema.

  // --- FOOTER ---
  div(class="mt-20 text-center border-t border-slate-200 dark:border-slate-800 pt-8")
    p(class="text-sm font-bold text-slate-400 uppercase tracking-widest") HIS System v1.0rs
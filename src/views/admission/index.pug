extends ../layouts/main

block content
  div(class="max-w-7xl mx-auto mt-6")
    div(class="flex justify-between items-center mb-8")
      div
        h2(class="text-xs font-bold text-blue-600 uppercase tracking-widest") Admisión
        h1(class="text-4xl font-black") Pacientes
      a(href="/admision/nuevo" class="bg-blue-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-blue-700 shadow-sm transition") + Nuevo Paciente

    //- Barra de búsqueda
    form(action="/admision" method="GET" class="mb-6 flex gap-4")
      input(type="text" name="search" value=(search || '') placeholder="Buscar por Nombre, Apellido o DNI..." class="flex-1 px-5 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm")
      button(type="submit" class="bg-slate-800 text-white px-8 py-3 rounded-xl font-bold hover:bg-slate-900 shadow-sm transition") Buscar
      if search
        a(href="/admision" class="bg-slate-200 text-slate-700 px-6 py-3 rounded-xl font-bold hover:bg-slate-300 shadow-sm transition flex items-center") Limpiar

    div(class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm")
      table(class="w-full text-left border-collapse")
        thead(class="bg-slate-50 border-b border-slate-200 text-slate-500 text-xs uppercase tracking-wider")
          tr
            th(class="p-5 font-bold") Nombre
            th(class="p-5 font-bold") DNI
            th(class="p-5 font-bold") Obra Social
            th(class="p-5 font-bold") Teléfono
            th(class="p-5 font-bold text-center") Estado
            th(class="p-5 font-bold text-center") Acciones

        tbody(class="divide-y divide-slate-100")
          each paciente in pacientes
            tr(class="hover:bg-slate-50 transition-colors")
              
              // Nombre + Descripción NN
              td(class="p-5")
                div
                  p(class="font-bold") #{paciente.apellido}, #{paciente.nombre}
                  
                  // === DESCRIPCIÓN DE PACIENTE NN ===
                  if paciente.es_nn && paciente.antecedentes
                    div(class="mt-1")
                      span(class="inline-block bg-orange-100 text-orange-700 text-xs font-bold px-2 py-0.5 rounded")
                        | NN
                      span(class="ml-2 text-xs text-orange-600 italic") #{paciente.antecedentes}

              // DNI
              td(class="p-5") #{paciente.dni || 'NN'}

              // Obra Social
              td(class="p-5")
                if paciente.ObraSocial && paciente.ObraSocial.nombre
                  span(class="inline-block bg-blue-100 text-blue-700 text-xs font-bold px-3 py-1 rounded-full") #{paciente.ObraSocial.nombre}
                else
                  span(class="text-slate-400") #{paciente.obra_social || 'Particular'}

              // Teléfono
              td(class="p-5 text-slate-600") #{paciente.telefono || '-'}

              // Estado
              td(class="p-5 text-center")
                if paciente.Internacions && paciente.Internacions.length > 0
                  span(class="bg-emerald-100 text-emerald-700 text-xs font-bold px-3 py-1 rounded-lg") Internado
                else if paciente.Visita && paciente.Visita.length > 0
                  span(class="bg-orange-100 text-orange-700 text-xs font-bold px-3 py-1 rounded-lg") En Espera
                else if paciente.es_nn
                  span(class="bg-red-100 text-red-700 text-xs font-bold px-3 py-1 rounded-lg") NN
                else
                  span(class="bg-slate-100 text-slate-600 text-xs font-bold px-3 py-1 rounded-lg") Activo

              // Acciones
              td(class="p-5 text-center flex justify-center gap-3")
                a(href=`/admision/editar/${paciente.id}` class="text-blue-600 hover:underline") Editar
                
                if paciente.activo
                  form(action=`/admision/desactivar/${paciente.id}` method="POST" class="inline" onsubmit="return confirm('¿Desactivar este paciente?')")
                    button(type="submit" class="text-amber-600 hover:underline") Desactivar
                else
                  form(action=`/admision/reactivar/${paciente.id}` method="POST" class="inline" onsubmit="return confirm('¿Reactivar este paciente?')")
                    button(type="submit" class="text-emerald-600 hover:underline") Reactivar
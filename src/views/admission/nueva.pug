extends ../layouts/main

block content
  div(class="max-w-4xl mx-auto")
    h1(class="text-3xl font-bold mb-8") Nueva Admisión

    // === BUSCADOR DE PACIENTE EXISTENTE ===
    div(class="bg-white p-8 rounded-3xl border border-slate-200 mb-8")
      h3(class="font-bold mb-6 text-xl") Buscar Paciente Existente

      form(action="/admision/nueva" method="GET" class="mb-6")
        div(class="flex gap-3")
          input(type="text" name="search" placeholder="Buscar por DNI, nombre o apellido..." 
                value=search class="flex-1 border border-slate-300 rounded-2xl px-5 py-3 text-lg")
          button(type="submit" class="bg-slate-800 text-white px-8 py-3 rounded-2xl font-bold hover:bg-black")
            | Buscar

      if pacientesEncontrados && pacientesEncontrados.length > 0
        h4(class="font-bold mb-4") Resultados de la búsqueda
        each paciente in pacientesEncontrados
          form(action="/admision/nueva" method="POST" class="mb-3")
            input(type="hidden" name="paciente_id" value=paciente.id)
            button(type="submit" 
                  class="w-full flex justify-between items-center p-5 border border-slate-200 rounded-2xl hover:bg-blue-50 text-left")
              div
                span(class="font-bold text-lg") #{paciente.apellido}, #{paciente.nombre}
                if paciente.dni
                  span(class="ml-4 text-sm text-slate-500") DNI: #{paciente.dni}
              span(class="text-blue-600 font-bold text-sm") Seleccionar →

    // === REGISTRAR PACIENTE NN + ADMISIÓN ===
    div(class="bg-white p-8 rounded-3xl border border-slate-200")
      h3(class="font-bold mb-6 text-xl text-red-600") Registrar Paciente NN + Admisión

      form(action="/admision/nueva" method="POST")
        input(type="hidden" name="es_nn" value="true")

        div(class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6")
          div
            label(class="block text-sm font-bold mb-2") Nombre
            input(type="text" name="nombre" class="w-full border border-slate-300 rounded-2xl px-4 py-3" required)
          div
            label(class="block text-sm font-bold mb-2") Apellido
            input(type="text" name="apellido" class="w-full border border-slate-300 rounded-2xl px-4 py-3" required)
          div
            label(class="block text-sm font-bold mb-2") Sexo
            select(name="sexo" class="w-full border border-slate-300 rounded-2xl px-4 py-3")
              option(value="M") Masculino
              option(value="F") Femenino
              option(value="X" selected) No especificado / NN

        div(class="mb-6")
          label(class="block text-sm font-bold mb-2") Tipo de Admisión
          select(name="tipo" class="w-full border border-slate-300 rounded-2xl px-4 py-3" required)
            option(value="Programada") Programada
            option(value="Derivacion") Derivación
            option(value="Guardia") Guardia
            option(value="Emergencia") Emergencia

        div(class="mb-8")
          label(class="block text-sm font-bold mb-2") Motivo de la Admisión
          textarea(name="motivo" rows="4" class="w-full border border-slate-300 rounded-2xl px-4 py-3" placeholder="Describa el motivo..." required)

        button(type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-4 rounded-2xl text-lg")
          | Registrar Paciente NN + Admisión

    script.
        // Mostrar u ocultar campos de paciente NN según la selección
        const esNNRadios = document.querySelectorAll('input[name="es_nn"]');
        const nnFields = document.getElementById('nn-fields');
    
        esNNRadios.forEach(radio => {
            radio.addEventListener('change', () => {
            if (radio.value === 'true' && radio.checked) {
                nnFields.classList.remove('hidden');
            } else {
                nnFields.classList.add('hidden');
            }
            });
        });
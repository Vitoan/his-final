extends ../layouts/main

block content
  div(class="max-w-5xl mx-auto")
    h1(class="text-3xl font-bold mb-2") Nueva Admisión
    p(class="text-slate-500 mb-8") Registre un nuevo ingreso hospitalario

    // === MENSAJES DE ERROR ===
    if error
      if error === 'ya_tiene_admision'
        div(class="bg-red-100 border border-red-300 text-red-800 p-4 rounded-2xl mb-6 flex items-start gap-3")
          div(class="text-xl mt-0.5") ⚠️
          div
            p(class="font-bold") Este paciente ya tiene una admisión activa o pendiente.
            p(class="text-sm mt-1") No se puede crear otra admisión hasta que se cierre la actual.

      else if error === 'crear_admision'
        div(class="bg-red-100 border border-red-300 text-red-800 p-4 rounded-2xl mb-6 flex items-start gap-3")
          div(class="text-xl mt-0.5") ⚠️
          div
            p(class="font-bold") Ocurrió un error al crear la admisión.
            p(class="text-sm mt-1") Por favor intente nuevamente.

    div(class="grid grid-cols-1 lg:grid-cols-5 gap-8")
      
      // === COLUMNA IZQUIERDA: BUSCAR PACIENTE ===
      div(class="lg:col-span-3")
        div(class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm h-full")
          div(class="flex items-center gap-3 mb-6")
            div(class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-xl") 🔍
            h3(class="text-xl font-bold") Buscar Paciente Existente

          form(action="/admision/nueva" method="GET")
            div(class="flex gap-3 mb-6")
              input(type="text" name="search" placeholder="DNI, nombre o apellido..." value=search 
                    class="flex-1 border border-slate-300 rounded-2xl px-5 py-3 text-lg focus:ring-2 focus:ring-blue-500 outline-none")
              button(type="submit" class="bg-slate-800 hover:bg-black text-white px-8 py-3 rounded-2xl font-bold transition")
                | Buscar

          if pacientesEncontrados && pacientesEncontrados.length > 0
            div(class="space-y-3")
              each p in pacientesEncontrados
                form(action="/admision/nueva" method="POST")
                  input(type="hidden" name="paciente_id" value=p.id)
                  button(type="submit" class="w-full text-left p-5 border border-slate-200 hover:border-blue-300 rounded-2xl hover:bg-blue-50 transition flex justify-between items-center group")
                    div
                      p(class="font-bold text-lg") #{p.apellido}, #{p.nombre}
                      if p.dni
                        p(class="text-sm text-slate-500") DNI: #{p.dni}
                    span(class="text-blue-600 font-bold group-hover:translate-x-1 transition") Seleccionar →

      // === COLUMNA DERECHA: PACIENTE NN ===
      div(class="lg:col-span-2")
        div(class="bg-red-50 border border-red-200 rounded-3xl p-8 h-full")
          div(class="flex items-center gap-3 mb-6")
            div(class="w-10 h-10 rounded-xl bg-red-500 text-white flex items-center justify-center text-xl") 🚨
            h3(class="text-xl font-bold text-red-800") Paciente NN (Sin Identificar)

          p(class="text-sm text-red-700 mb-6") Use esta opción para emergencias o pacientes sin documentación.

          form(action="/admision/nueva" method="POST")
            input(type="hidden" name="es_nn" value="true")

            div(class="space-y-4")
              div
                label(class="block text-xs font-bold text-red-700 mb-1") Nombre
                input(type="text" name="nombre" required class="w-full border border-red-200 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-red-500 outline-none")

              div
                label(class="block text-xs font-bold text-red-700 mb-1") Apellido
                input(type="text" name="apellido" required class="w-full border border-red-200 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-red-500 outline-none")

              div
                label(class="block text-xs font-bold text-red-700 mb-1") Sexo
                select(name="sexo" class="w-full border border-red-200 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-red-500 outline-none")
                  option(value="M") Masculino
                  option(value="F") Femenino
                  option(value="X" selected) No especificado

              div
                label(class="block text-xs font-bold text-red-700 mb-1") Descripción breve (opcional)
                textarea(
                  name="descripcion_nn" 
                  rows="3" 
                  placeholder="Ej: Varón aprox 40 años, sin documentación, traído por ambulancia..."
                  class="w-full border border-red-200 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-red-500 outline-none text-sm"
                )

              div
                label(class="block text-xs font-bold text-red-700 mb-1") Tipo de Admisión
                select(name="tipo" class="w-full border border-red-200 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-red-500 outline-none" required)
                  option(value="Emergencia") Emergencia
                  option(value="Guardia") Guardia
                  option(value="Programada") Programada
                  option(value="Derivacion") Derivación

              div
                label(class="block text-xs font-bold text-red-700 mb-1") Motivo
                textarea(name="motivo" rows="3" required placeholder="Motivo de ingreso..." class="w-full border border-red-200 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-red-500 outline-none")

            button(type="submit" class="mt-6 w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-2xl transition")
              | Registrar Paciente NN + Admisión
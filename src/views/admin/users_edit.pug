extends ../layouts/main

block content
  div(class="max-w-2xl mx-auto")
    h1(class="text-3xl font-bold mb-8") Editar Usuario

    form(action=`/admin/usuarios/actualizar/${usuario.id}` method="POST" class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 space-y-6")
      
      div
        label(class="block text-sm font-bold mb-2") Nombre
        input(type="text" name="nombre" value=usuario.nombre class="w-full border border-slate-300 rounded-xl px-4 py-3" required)

      div
        label(class="block text-sm font-bold mb-2") Apellido
        input(type="text" name="apellido" value=usuario.apellido class="w-full border border-slate-300 rounded-xl px-4 py-3" required)

      div
        label(class="block text-sm font-bold mb-2") Email
        input(type="email" name="email" value=usuario.email class="w-full border border-slate-300 rounded-xl px-4 py-3" required)

      div
        label(class="block text-sm font-bold mb-2") Rol
        select(name="rol" class="w-full border border-slate-300 rounded-xl px-4 py-3" required)
          option(value="Admin" selected=(usuario.rol === 'Admin')) Admin
          option(value="Medico" selected=(usuario.rol === 'Medico')) Médico
          option(value="Enfermeria" selected=(usuario.rol === 'Enfermeria')) Enfermería
          option(value="Admision" selected=(usuario.rol === 'Admision')) Admisión
          option(value="Paciente" selected=(usuario.rol === 'Paciente')) Paciente

      div(class="flex gap-4 pt-4")
        a(href="/admin/usuarios" class="w-1/3 text-center bg-slate-200 text-slate-700 font-bold py-3 rounded-xl hover:bg-slate-300 transition") Cancelar
        button(type="submit" class="w-2/3 bg-blue-600 text-white font-bold py-3 rounded-xl hover:bg-blue-700 transition") Guardar Cambios
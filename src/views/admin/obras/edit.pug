extends ../../layouts/main

block content
  div(class="max-w-2xl mx-auto mt-10")
    div(class="mb-8 flex justify-between items-center")
      div
        h2(class="text-sm font-bold text-blue-600 uppercase tracking-widest") Administración
        h1(class="text-3xl font-black") Editar Obra Social
      a(href="/admin/obras-sociales" class="text-slate-500 hover:text-slate-700 font-bold") ← Volver

    form(action=`/admin/obras-sociales/editar/${obra.id}` method="POST" class="bg-white border border-slate-200 shadow-sm rounded-3xl p-8 space-y-6")
      div
        label(class="block text-sm font-bold text-slate-700 mb-2") Nombre de la Obra Social *
        input(type="text" name="nombre" value=obra.nombre required class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none")

      div
        label(class="block text-sm font-bold text-slate-700 mb-2") Descripción
        textarea(name="descripcion" rows="4" class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none resize-y") #{obra.descripcion || ''}

      div
        label(class="flex items-center gap-2")
          input(type="checkbox" name="activo" checked=obra.activo)
          span Activa

      div(class="pt-6 border-t border-slate-100 flex gap-4")
        a(href="/admin/obras-sociales" class="flex-1 text-center bg-slate-100 text-slate-700 font-bold py-3 rounded-xl hover:bg-slate-200") Cancelar
        button(type="submit" class="flex-1 bg-blue-600 text-white font-bold py-3 rounded-xl hover:bg-blue-700") Guardar Cambios
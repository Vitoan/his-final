extends ../../layouts/main

block content
  div(class="max-w-7xl mx-auto")
    
    // Header
    div(class="flex justify-between items-center mb-8")
      div
        h2(class="text-xs font-bold text-blue-500 dark:text-rose-500 mb-1 tracking-widest uppercase") Infraestructura
        h1(class="text-3xl font-bold text-slate-900 dark:text-white") Gestión de <span class="text-blue-600 dark:text-rose-500">Camas</span>
      
      a(href="/admin/camas/nuevo" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-bold flex items-center gap-2 transition-colors")
        span +
        | Nueva Cama

    // Alertas
    if success
      div(class="mb-6 bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 p-4 rounded-xl font-medium")
        | #{success}
    
    if error
      div(class="mb-6 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200 p-4 rounded-xl font-medium")
        | #{error}

    // Tabla
    div(class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-[2rem] shadow-sm overflow-hidden")
      table(class="w-full text-left border-collapse")
        thead(class="bg-slate-50 dark:bg-slate-900/50 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider")
          tr
            th(class="p-5 font-bold") Cama
            th(class="p-5 font-bold") Habitación
            th(class="p-5 font-bold") Ala / Sector
            th(class="p-5 font-bold text-center") Estado
            th(class="p-5 font-bold text-center") Acciones

        tbody(class="divide-y divide-slate-100 dark:divide-slate-700")
          if camas && camas.length > 0
            each cama in camas
              tr(class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition-colors")
                
                td(class="p-5")
                  span(class="font-bold text-lg text-slate-900 dark:text-white") Cama #{cama.numero_cama}

                td(class="p-5")
                  if cama.Habitacion
                    span(class="px-3 py-1 rounded-full text-xs font-bold bg-blue-50 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300")
                      | Habitación #{cama.Habitacion.numero}
                  else
                    span(class="text-slate-400 italic") Sin habitación

                td(class="p-5 text-slate-600 dark:text-slate-400")
                  if cama.Habitacion && cama.Habitacion.Ala
                    | #{cama.Habitacion.Ala.nombre}
                  else
                    span(class="text-slate-400 italic") Sin ala asignada

                td(class="p-5 text-center")
                  if cama.estado === 'Disponible'
                    span(class="px-3 py-1 inline-flex text-xs font-bold rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300")
                      | Disponible
                  else if cama.estado === 'Ocupada'
                    span(class="px-3 py-1 inline-flex text-xs font-bold rounded-full bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300")
                      | Ocupada
                  else if cama.estado === 'Limpieza'
                    span(class="px-3 py-1 inline-flex text-xs font-bold rounded-full bg-yellow-100 text-yellow-700 dark:bg-yellow-900/40 dark:text-yellow-300")
                      | Limpieza
                  else if cama.estado === 'Mantenimiento'
                    span(class="px-3 py-1 inline-flex text-xs font-bold rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300")
                      | Mantenimiento

                td(class="p-5 text-center")
                  div(class="flex justify-center gap-2 flex-wrap")
                    // Editar
                    a(href=`/admin/camas/editar/${cama.id}` 
                      class="bg-blue-100 hover:bg-blue-200 text-blue-700 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors")
                      | ✏️ Editar

                    // Eliminar
                    form(action=`/admin/camas/eliminar/${cama.id}` method="POST" class="inline" onsubmit="return confirm('¿Estás seguro de eliminar esta cama? Esta acción no se puede deshacer y fallará si la cama tiene registros históricos.')")
                      button(type="submit" 
                             class="bg-red-100 hover:bg-red-200 text-red-700 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors")
                        | 🗑️ Eliminar
          else
            tr
              td(colspan="5" class="p-10 text-center text-slate-500 dark:text-slate-400")
                | No hay camas registradas en el sistema.
